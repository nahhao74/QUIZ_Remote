# Mau cau hinh ClassPulse. Chep thanh .env roi dien cac gia tri <...>. Khong dua .env that len mang.
POSTGRES_USER=classpulse
POSTGRES_PASSWORD=<mat-khau-database>
POSTGRES_DB=classpulse
DATABASE_URL=postgresql://classpulse:<mat-khau-database>@localhost:5432/classpulse?schema=public
JWT_ACCESS_SECRET=<chuoi-ngau-nhien-dai-it-nhat-32-ky-tu>
FRONTEND_ORIGIN=http://localhost,http://localhost:8080,http://localhost:5173
COOKIE_SECURE=false
TRUST_PROXY=true

MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=backend
MQTT_PASSWORD=<mat-khau-mqtt-backend>
# Thiet bi ESP32 va trinh gia lap dang dung tai khoan nay (ghi trong firmware ClassPulseQuizDevice).
MQTT_SIMULATOR_ENABLED=true
MQTT_SIMULATOR_USERNAME=simulator
MQTT_SIMULATOR_PASSWORD=simulator-dev-only
VITE_MQTT_USERNAME=simulator
VITE_MQTT_PASSWORD=simulator-dev-only
VITE_MQTT_WS_URL=ws://localhost:8083/mqtt
# IP Wi-Fi cua may chay web (hostname -I). chay-demo.sh tu cap nhat dong nay.
MQTT_TCP_BIND_ADDRESS=10.246.235.139

EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=<mat-khau-dashboard-emqx>
EMQX_NODE_COOKIE=<chuoi-ngau-nhien>

# AI (tuy chon): gemini | ollama | anthropic. Khoa Gemini mien phi tai aistudio.google.com/apikey
GEMINI_API_KEY=
AI_PROVIDER=
