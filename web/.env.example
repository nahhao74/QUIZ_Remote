# ClassPulse configuration template. Copy it to .env and fill in the <...> values. Never publish a real .env.
POSTGRES_USER=classpulse
POSTGRES_PASSWORD=<database-password>
POSTGRES_DB=classpulse
DATABASE_URL=postgresql://classpulse:<database-password>@localhost:5432/classpulse?schema=public
JWT_ACCESS_SECRET=<random-string-of-at-least-32-characters>
FRONTEND_ORIGIN=http://localhost,http://localhost:8080,http://localhost:5173
COOKIE_SECURE=false
TRUST_PROXY=true

MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=backend
MQTT_PASSWORD=<backend-mqtt-password>
# The ESP32 devices and the simulator use this account (written in the ClassPulseQuizDevice firmware).
MQTT_SIMULATOR_ENABLED=true
MQTT_SIMULATOR_USERNAME=simulator
MQTT_SIMULATOR_PASSWORD=simulator-dev-only
VITE_MQTT_USERNAME=simulator
VITE_MQTT_PASSWORD=simulator-dev-only
VITE_MQTT_WS_URL=ws://localhost:8083/mqtt
# Wi-Fi IP of the machine running the web app (hostname -I). The demo start script updates this line automatically.
MQTT_TCP_BIND_ADDRESS=10.246.235.139

EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=<emqx-dashboard-password>
EMQX_NODE_COOKIE=<random-string>

# AI (optional): gemini | ollama | anthropic. A free Gemini key is available at aistudio.google.com/apikey
GEMINI_API_KEY=
AI_PROVIDER=
